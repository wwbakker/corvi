{
  "name": "integrated-work-environment",
  "module": "src/server.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "NODE_ENV=production bun src/server.ts",
    "test": "trap 'status=$?; bun scripts/clean-test.ts --kill; exit $status' EXIT; IWE_ROOT=\"${TMPDIR:-/tmp}/iwe-test-root\" IWE_CONFIG=\"${TMPDIR:-/tmp}/iwe-test-config.json\" bun test --timeout 30000",
    "test:coverage": "trap 'status=$?; bun scripts/clean-test.ts --kill; exit $status' EXIT; IWE_ROOT=\"${TMPDIR:-/tmp}/iwe-test-root\" IWE_CONFIG=\"${TMPDIR:-/tmp}/iwe-test-config.json\" bun test --coverage --timeout 30000",
    "test:clean": "bun scripts/clean-test.ts",
    "typecheck": "tsc --noEmit",
    "outline": "bun scripts/outline.ts",
    "lint": "eslint .",
    "effect:lint": "effect-language-service diagnostics --project tsconfig.json --format text",
    "shot": "bun scripts/shot.ts",
    "icons": "bun scripts/icons.ts",
    "extension:install": "bun scripts/extension.ts install",
    "extension:uninstall": "bun scripts/extension.ts uninstall",
    "app:install": "bun scripts/app.ts install",
    "app:uninstall": "bun scripts/app.ts uninstall",
    "app:permissions": "bun scripts/permissions.ts",
    "app:drive": "osascript -l JavaScript scripts/drive.js",
    "app:sandbox": "bun scripts/sandbox.ts"
  },
  "dependencies": {
    "effect": "^3.22.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@effect/language-service": "^0.87.2",
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.10.0",
    "playwright": "^1.63.0",
    "typescript-eslint": "^8.70.0"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  }
}
