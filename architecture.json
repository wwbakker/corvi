{
  "packages": {
    "@corvi/contracts": {
      "dependsOn": [],
      "external": [
        "effect"
      ]
    },
    "@corvi/configuration": {
      "dependsOn": [
        "@corvi/contracts"
      ]
    },
    "@corvi/changes": {
      "dependsOn": [
        "@corvi/contracts"
      ]
    },
    "@corvi/repositories": {
      "dependsOn": [
        "@corvi/contracts"
      ]
    },
    "@corvi/terminals": {
      "dependsOn": [
        "@corvi/contracts"
      ]
    },
    "@corvi/agents": {
      "dependsOn": [
        "@corvi/contracts"
      ]
    },
    "@corvi/actions": {
      "dependsOn": [
        "@corvi/contracts",
        "@corvi/terminals"
      ],
      "external": [
        "effect",
        "yaml",
        "node:fs",
        "node:fs/promises",
        "node:path",
        "node:url"
      ]
    },
    "@corvi/shell": {
      "dependsOn": [
        "@corvi/contracts"
      ]
    },
    "@corvi/workflows": {
      "dependsOn": [
        "@corvi/contracts",
        "@corvi/configuration",
        "@corvi/changes",
        "@corvi/repositories",
        "@corvi/terminals",
        "@corvi/agents"
      ]
    },
    "@corvi/client": {
      "dependsOn": [
        "@corvi/contracts"
      ]
    },
    "@corvi/cli": {
      "dependsOn": [
        "@corvi/client",
        "@corvi/configuration",
        "@corvi/contracts"
