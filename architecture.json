      "external": [
        "effect"
      ],
      "node": true
    },
    "@corvi/github": {
      "dependsOn": [
        "@corvi/contracts",
        "@corvi/shell"
      ]
    },
    "@corvi/jira": {
      "dependsOn": [
        "@corvi/contracts",
        "@corvi/configuration",
        "@corvi/shell"
      ]
    },
    "@corvi/azure-devops": {
      "dependsOn": [
        "@corvi/contracts",
        "@corvi/configuration",
        "@corvi/github",
        "@corvi/shell"
      ]
    },
    "@corvi/pi": {
      "dependsOn": [],
      "external": [
        "@earendil-works/pi-coding-agent"
      ]
    },
    "@corvi/opencode": {
      "dependsOn": [],
      "external": [
        "@opencode-ai/plugin"
      ]
    },
    "@corvi/server": {
      "dependsOn": [
        "@corvi/contracts",
        "@corvi/configuration",
        "@corvi/changes",
        "@corvi/repositories",
        "@corvi/terminals",
        "@corvi/actions",
        "@corvi/agents",
        "@corvi/workflows",
        "@corvi/client",
        "@corvi/github",
        "@corvi/jira",
        "@corvi/azure-devops",
        "@corvi/shell"
      ],
      "node": true
    },
    "@corvi/web": {
      "dependsOn": [
        "@corvi/client",
        "@corvi/contracts",
        "@corvi/changes",
        "@corvi/terminals",
        "@corvi/actions",
        "@corvi/agents"
      ]
    },
    "@corvi/desktop": {
      "dependsOn": [
        "@corvi/web",
        "@corvi/contracts",
        "@corvi/configuration"
      ],
      "node": true
    }
  }
}
